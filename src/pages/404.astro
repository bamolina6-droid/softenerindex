---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That SoftenerIndex URL does not exist." canonicalPath="/404">
  <section class="hero">
    <div class="wrap prose">
      <p class="kicker">404</p>
      <h1>No such page</h1>
      <p class="lede">That path is not in the index. Try a guide or the Phoenix city file.</p>
      <div class="actions">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/guides">Guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
