---
import Page from '../layouts/Page.astro';
---

<Page title="Page not found" description="That SoftenerIndex URL is not in the index.">
  <section class="hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>No page at this path</h1>
      <p class="lede">
        Try the <a href="/">home page</a>, <a href="/guides">guides</a>, or
        <a href="/az/phoenix">Phoenix</a>.
      </p>
    </div>
  </section>
</Page>
